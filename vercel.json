{
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/launch",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/launch.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/hero",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/hero.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/font-options",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/font-options.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/font-preview",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/font-preview.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/character-preview",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/character-preview.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/landing",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/landing.html",
            "destination": "/",
            "permanent": true
        }
    ]
}
