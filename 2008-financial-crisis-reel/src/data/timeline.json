   {
    "text": "we need to go back",
    "s": 13.006,
    "e": 13.806
   },
   {
    "text": "a few years.",
    "s": 13.806,
    "e": 15.226
   },
   {
    "text": "American banks",
    "s": 15.226,
    "e": 15.906
   },
   {
    "text": "were handing out mortgages",
    "s": 15.906,
    "e": 17.206
   },
   {
    "text": "to people who could",
    "s": 17.206,
    "e": 18.546
   },
   {
    "text": "barely afford them.",
    "s": 18.546,
    "e": 20.106
   },
   {
    "text": "These were called",
    "s": 20.106,
    "e": 20.746
   },
   {
    "text": "subprime mortgages.",
    "s": 20.746,
    "e": 22.356
   }
  ],
  "s3": [
   {
    "text": "But banks didn't just keep",
    "s": 22.799,
    "e": 23.919
   },
   {
    "text": "these mortgages.",
    "s": 23.919,
    "e": 25.299
   },
   {
    "text": "They bundled thousands",
    "s": 25.299,
    "e": 26.319
   },
   {
    "text": "of them together",
    "s": 26.319,
    "e": 27.219
   },
   {
    "text": "into financial products",
    "s": 27.219,
    "e": 28.959
   },
   {
    "text": "called mortgage-backed securities,",
    "s": 28.959,
    "e": 31.699
   },
   {
    "text": "then sold them",
    "s": 31.699,
    "e": 32.439
   },
   {
    "text": "to investors",
    "s": 32.439,
    "e": 33.199
   },
   {
    "text": "around the world.",
    "s": 33.199,
    "e": 34.509
   }
  ],
  "s4": [
   {
    "text": "Then homeowners",
    "s": 34.752,
    "e": 35.332
   },
   {
    "text": "started defaulting.",
    "s": 35.332,
    "e": 37.032
   },
   {
    "text": "House prices fell.",
    "s": 37.032,
    "e": 38.812
   },
   {
    "text": "Suddenly, those supposedly",
