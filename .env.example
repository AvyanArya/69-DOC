# Lumera server settings. Copy to .env for local runs (never commit .env).
# Every variable is read in server/config.js and documented in BACKEND.md.

# Which deployment this is: production | staging | development
APP_ENV=development
NODE_ENV=development
PORT=8787
# HOST=127.0.0.1                 # 0.0.0.0 in containers
# DATA_DIR=./data                # SQLite database and backups; a persistent disk in hosting
# PUBLIC_URL=https://lumera.example   # used to build links in emails

# REQUIRED in production: 32 random bytes, e.g. `openssl rand -hex 32`.
# It encrypts every member's figures. Lose it and that data cannot be read.
# Use a different key for staging and production, and back it up.
DATA_ENCRYPTION_KEY=

# Comma-separated emails that become admins when they sign up or log in.
ADMIN_EMAILS=

# Behind a hosting proxy (Render, Fly, a load balancer): read the client
# address from X-Forwarded-For, and send cookies only over HTTPS.
# TRUST_PROXY=true
# COOKIE_SECURE=true
# SESSION_TTL_DAYS=30

# Email for password reset links (https://resend.com). All three, plus
# PUBLIC_URL, must be set for emails to be sent.
# RESEND_API_KEY=
# MAIL_FROM=Lumera <hello@your-domain>
# SUPPORT_EMAIL=help@your-domain

# Team preview: one shared password for the whole site (any username).
# SITE_PASSWORD=
# On by default everywhere except APP_ENV=production:
# NOINDEX=true            # X-Robots-Tag: noindex, and robots.txt disallows all
# FEEDBACK_ENABLED=true   # the in-app Feedback button
# SERVE_PREVIEWS=true     # design previews and the offline single-file build
# LOG_REQUESTS=true       # one JSON line per API request (on when NODE_ENV=production)

# Optional company-logo services (the free icon services work without them).
# LOGO_DEV_SECRET_KEY=
# LOGO_DEV_PUBLISHABLE_KEY=
# BRANDFETCH_CLIENT_ID=
# LOGO_LOOKUPS=true
